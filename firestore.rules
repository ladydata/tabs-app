rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the document owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && isOwner(userId);

      // Users can create their own profile
      allow create: if isAuthenticated() && isOwner(userId);

      // Users can update their own profile
      allow update: if isAuthenticated() && isOwner(userId);

      // Users cannot delete profiles
      allow delete: if false;
    }

    // Allow users to find other users by email (for adding to groups)
    match /users/{userId} {
      allow read: if isAuthenticated();
    }

    // Groups collection
    match /groups/{groupId} {
      // Helper function to check if user is a member of the group
      function isMember() {
        return isAuthenticated() &&
               request.auth.uid in resource.data.memberIds;
      }

      // Helper function to check if user is an admin of the group
      function isAdmin() {
        return isAuthenticated() &&
               resource.data.members[request.auth.uid].role == 'admin';
      }

      // Members can read the group
      allow read: if isMember();

      // Authenticated users can create groups (they become the first member)
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.memberIds;

      // Members can update the group
      allow update: if isMember();

      // Only admins can delete the group
      allow delete: if isAdmin();

      // Expenses subcollection
      match /expenses/{expenseId} {
        // Members can read expenses
        allow read: if isAuthenticated() &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Members can create expenses
        allow create: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Members can update expenses
        allow update: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Members can delete expenses
        allow delete: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      // Settlements subcollection
      match /settlements/{settlementId} {
        // Members can read settlements
        allow read: if isAuthenticated() &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Members can create settlements
        allow create: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Members can delete settlements (to undo)
        allow delete: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Settlements cannot be updated
        allow update: if false;
      }

      // Activity subcollection
      match /activity/{activityId} {
        // Members can read activity
        allow read: if isAuthenticated() &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Members can create activity logs
        allow create: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Activity logs cannot be updated or deleted
        allow update, delete: if false;
      }
    }

    // Exchange rates cache (readable by all authenticated users, writable by Cloud Functions)
    match /exchangeRates/{rateId} {
      allow read: if isAuthenticated();
      // Writing is handled by Cloud Functions with admin SDK
      allow write: if false;
    }
  }
}
